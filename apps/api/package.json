{
  "name": "@daichem/tally-vm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/functions/*.js",
  "files": [
    "host.json",
    "src"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm check",
    "check": "node --check src/functions/vms.js && node --check src/lib/auth.js && node --check src/lib/config.js && node --check src/lib/http.js && node --check src/lib/vm-service.js",
    "start": "func start",
    "test": "node --test"
  },
  "dependencies": {
    "@azure/arm-compute": "25.1.1",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "jose": "^6.2.12"
  }
}
